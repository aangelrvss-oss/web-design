# Pro Reforma · Apache. Revisar antes de publicar: ver ../README.md.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
# Las URL actuales de Duda no llevan barra final; mod_dir responde 301 a la
# versión con barra (/servicios/pinturas -> /servicios/pinturas/).
DirectorySlash On

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^index\.html?$ / [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  # lh3.googleusercontent.com: fotos de perfil de los autores, solo si se activa la API de reseñas.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data: https://lh3.googleusercontent.com; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  <FilesMatch "\.(woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain application/json
</IfModule>
