# Coartada needs no secrets. All variables are optional.
PORT=3000              # HTTP + WebSocket port
HOST=0.0.0.0           # bind address
TRUST_PROXY=0          # 1 behind a reverse proxy (Render, Fly, nginx) so rate limits use the real client IP
MAX_ROOMS=1000         # refuse new rooms beyond this
CORS_ORIGINS=          # only if the client is served from another origin (comma-separated)
CLIENT_DIR=            # override path to the built client (default: dist/client next to dist/server.mjs)
