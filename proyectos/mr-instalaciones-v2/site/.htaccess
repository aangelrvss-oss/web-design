# MRI V2 · configuración para Apache (alojamiento actual en WordPress/PHP).
# Revisar antes de publicar: ver README.md, sección "Puesta en producción".

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # URLs antiguas sin barra final -> con barra (las páginas se conservan)
  RewriteRule ^aviso-legal$ /aviso-legal/ [R=301,L]
  RewriteRule ^politica-de-privacidad$ /politica-de-privacidad/ [R=301,L]
  RewriteRule ^politica-de-cookies$ /politica-de-cookies/ [R=301,L]
  RewriteRule ^certificaciones$ /certificaciones/ [R=301,L]
  # Restos habituales de WordPress que dejan de existir
  RewriteRule ^(feed|comments/feed)/?$ / [R=301,L]
  RewriteRule ^wp-(login|admin)(\.php)?/?$ - [G,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; media-src 'self' blob:; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  <FilesMatch "\.(woff2|webp|png|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

AddType video/mp4 .mp4
AddType video/webm .webm

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
