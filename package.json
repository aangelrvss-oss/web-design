{
  "name": "webs-propuesta",
  "private": true,
  "type": "module",
  "description": "Propuestas de rediseño web para negocios locales (una carpeta por proyecto en proyectos/)",
  "scripts": {
    "build:mri": "node proyectos/mr-instalaciones/src/build.mjs",
    "serve:mri": "SITE_ROOT=proyectos/mr-instalaciones/site php -S 127.0.0.1:4500 tools/dev/router.php",
    "qa:mri": "node proyectos/mr-instalaciones/qa/functional.mjs http://127.0.0.1:4500 qa/out/mri",
    "build:mri2": "node proyectos/mr-instalaciones-v2/src/build.mjs",
    "serve:mri2": "SITE_ROOT=proyectos/mr-instalaciones-v2/site php -S 127.0.0.1:4510 tools/dev/router.php",
    "qa:mri2": "node proyectos/mr-instalaciones-v2/qa/functional.mjs http://127.0.0.1:4510 qa/out/mri2",
    "qa:mri2:film": "node proyectos/mr-instalaciones-v2/qa/film.mjs http://127.0.0.1:4510 qa/out/mri2-film",
    "video:mri2": "node proyectos/mr-instalaciones-v2/tools/video/prepare.mjs",
    "build:living": "node proyectos/living-clean/src/build.mjs",
    "serve:living": "SITE_ROOT=proyectos/living-clean/site php -S 127.0.0.1:4600 tools/dev/router.php",
    "qa:living": "node proyectos/living-clean/qa/functional.mjs http://127.0.0.1:4600 qa/out/living",
    "demo:living": "cd proyectos/living-clean && node tools/demo/build-netlify.mjs",
    "build:proreforma": "node proyectos/pro-reforma/src/build.mjs",
    "serve:proreforma": "SITE_ROOT=proyectos/pro-reforma/site php -S 127.0.0.1:4700 tools/dev/router.php",
    "qa:proreforma": "node proyectos/pro-reforma/qa/functional.mjs http://127.0.0.1:4700 qa/out/pro-reforma",
    "qa:proreforma:anim": "node proyectos/pro-reforma/qa/animation.mjs http://127.0.0.1:4700/",
    "preview:proreforma": "node proyectos/pro-reforma/tools/preview/bundle.mjs",
    "qa:proreforma:backend": "node proyectos/pro-reforma/qa/backend.mjs",
    "demo:proreforma": "node proyectos/pro-reforma/tools/demo/build-netlify.mjs"
  }
}
